extends Node
## Global signal hub. Systems never reference each other directly.
@warning_ignore_start("unused_signal")

signal enemy_spawned(enemy: Node3D)
signal enemy_died(enemy: Node3D, reward: int)
signal enemy_reached_end(enemy: Node3D, damage: int)
signal damage_dealt(world_pos: Vector3, amount: float)
signal gold_changed(amount: int)
signal lives_changed(amount: int)
signal wave_started(index: int)
signal wave_spawn_finished(index: int)
signal all_waves_cleared()
signal level_won(stars: int)
signal level_lost()
signal build_spot_clicked(spot: Node3D)
signal tower_selected(tower: Node3D)
signal rally_point_requested(world_position: Vector3)
signal camera_shake(strength: float)
signal coin_pop(world_position: Vector3, amount: int)
signal hero_health_changed(current: float, maximum: float)
signal hero_level_changed(level: int, current_xp: int, required_xp: int)
signal tower_fired(world_position: Vector3)
signal tower_built(world_position: Vector3)
signal meteor_impacted(world_position: Vector3)
signal boss_spawned(boss: Node3D)
signal boss_health_changed(current: float, maximum: float)
signal boss_died(boss: Node3D)
signal heal_dealt(world_pos: Vector3, amount: float)
signal shards_awarded(amount: int, total: int)
signal upgrade_purchased(track: StringName, level: int)
signal tower_disabled(world_pos: Vector3, duration: float)
signal enemy_buffed(world_pos: Vector3)
signal campaign_completed
