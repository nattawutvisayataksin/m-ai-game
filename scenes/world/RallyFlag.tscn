func _ready() -> void:
	scale = Vector3.ZERO
	var tw := create_tween()
	tw.tween_property(self, \"scale\", Vector3.ONE, 0.3).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
"

